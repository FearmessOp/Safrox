# Cargo build output
/target/

# ISO images, the copied kernel ELF, captured serial logs
/build/

# Vendored bootloader; fetched automatically by `make`
/third_party/

# Python bytecode from scripts/.
#
# This was a line of its own until it got appended to the end of the
# comment below, where git read it as prose rather than as a pattern.
# A rule that silently stops being a rule is worth a note: nothing
# fails, the ignored files simply start appearing.
__pycache__/

# Serial logs and scratch output from debugging runs. Written to the
# working directory rather than build/ because a truncated terminal
# cannot be searched, so the evidence goes to a file first.
*.log

# The question-7 probe builds its own crate.
/scripts/m9-index-probe/target/

# The M15 spike assembles a boot sector to answer one question:
# does QMP `send-key` actually reach port 0x60 (ADR 056). The
# source is committed and the image is not — it is 512 bytes of
# build output and `run.py` there rebuilds it.
/scripts/m15-spike/probe.img
/scripts/m15-spike/*.o
# The root task is built as a separate crate (M12), so it has a
# `target/` of its own. `/target/` above is anchored to the
# repository root and does not reach it — the first `git add -A`
# after M12 staged 106 build artefacts before this line existed.
/roottask/target/


# Cargo.lock is committed: the kernel is a binary, and a reproducible build
# needs pinned dependency versions.

# Scratch disassembly from debugging sessions (M14).
f1.txt

# soak.sh keeps the first failing run here (ADR 023, K8).
build/soak/
